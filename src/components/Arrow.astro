---
interface Props {
  class?: string;
  direction?: 'right' | 'up-right';
}

const { class: className = 'size-4', direction = 'right' } = Astro.props;
---

<svg viewBox="0 0 16 16" class={className} fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
  {
    direction === 'right' ? (
      <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" stroke-linecap="square" />
    ) : (
      <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" stroke-linecap="square" />
    )
  }
</svg>
