---
import {
  HORIZONTAL,
  SYMBOL_PATH,
  VERTICAL,
  WORDMARK_CHEVRON,
  WORDMARK_CIRCLES,
  WORDMARK_STROKES,
} from '@/lib/brand';

interface Props {
  variant?: 'simbolo' | 'horizontal' | 'vertical' | 'wordmark';
  class?: string;
  /** Accessible name. Pass an empty string when the logo sits inside a labelled link. */
  title?: string;
}

const { variant = 'horizontal', class: className, title = 'BKode' } = Astro.props;

const viewBox = {
  simbolo: '0 0 144 144',
  horizontal: `0 0 ${HORIZONTAL.width} ${HORIZONTAL.height}`,
  vertical: `0 0 ${VERTICAL.width} ${VERTICAL.height}`,
  wordmark: '0 0 391 100',
}[variant];

const a11y = title ? ({ role: 'img', 'aria-label': title } as const) : ({ 'aria-hidden': 'true' } as const);
const showSymbol = variant !== 'wordmark';
const symbolTransform =
  variant === 'vertical' ? `translate(${VERTICAL.symbolX} 0) scale(${VERTICAL.symbolScale})` : undefined;
const wordmarkTransform = {
  simbolo: undefined,
  horizontal: `translate(${HORIZONTAL.wordmarkX} ${HORIZONTAL.wordmarkY})`,
  vertical: `translate(0 ${VERTICAL.wordmarkY})`,
  wordmark: undefined,
}[variant];
---

<svg viewBox={viewBox} class={className} fill="currentColor" {...a11y}>
  {
    showSymbol && (
      <g transform={symbolTransform}>
        <path d={SYMBOL_PATH} fill-rule="evenodd" />
      </g>
    )
  }
  {
    variant !== 'simbolo' && (
      <g transform={wordmarkTransform}>
        <g fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="butt" stroke-linejoin="miter">
          {WORDMARK_STROKES.map((d) => (
            <path d={d} />
          ))}
          {WORDMARK_CIRCLES.map((c) => (
            <circle cx={c.cx} cy={c.cy} r={c.r} />
          ))}
        </g>
        <polygon points={WORDMARK_CHEVRON} />
      </g>
    )
  }
</svg>
