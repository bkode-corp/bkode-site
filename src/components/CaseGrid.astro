---
import Arrow from '@/components/Arrow.astro';
import type { CaseStudy } from '@/data/cases';
import { segments } from '@/data/segments';

interface Props {
  items: readonly CaseStudy[];
  /** Closing cell that fills the last grid row. */
  cta?: { href: string; label: string; title: string };
}

const { items, cta } = Astro.props;

const segmentLabel = new Map(segments.map((s) => [s.slug, s.label] as const));

// The closing cell spans whatever is left of the last row, so no empty grid area shows the guide colour.
const mdSpan = { 0: 'md:col-span-2', 1: 'md:col-span-1' }[items.length % 2 as 0 | 1];
const lgSpan = { 0: 'lg:col-span-3', 1: 'lg:col-span-2', 2: 'lg:col-span-1' }[items.length % 3 as 0 | 1 | 2];
const oddWithoutCta = !cta && items.length % 2 === 1;
---

<ul class="cells md:grid-cols-2 lg:grid-cols-3">
  {
    items.map((item, i) => (
      <li class:list={[oddWithoutCta && i === items.length - 1 && 'md:col-span-2 lg:col-span-1']}>
        <a href={`/cases/${item.slug}`} class="group flex h-full flex-col gap-6 px-6 py-8 transition-colors hover:bg-coal/60 sm:px-8 sm:py-10">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="label">{item.segments.map((slug) => segmentLabel.get(slug)?.toLowerCase()).join(' · ')}</span>
            {item.status && <span class="chip">{item.status.toLowerCase()}</span>}
          </div>
          <div>
            <p class="label text-bone">{item.kind}</p>
            <h3 class="type-heading mt-2 text-paper">{item.name}</h3>
            <p class="mt-3 text-ash">{item.summary}</p>
          </div>
          <ul class="mt-auto flex flex-wrap gap-1.5" aria-label="Stack">
            {item.stack.map((tech) => (
              <li class="chip">{tech}</li>
            ))}
          </ul>
          <span class="link-arrow">
            Ver o case
            <Arrow />
          </span>
        </a>
      </li>
    ))
  }
  {
    cta && (
      <li class:list={[mdSpan, lgSpan]}>
        <a
          href={cta.href}
          class:list={[
            'group flex h-full flex-col justify-between gap-8 px-6 py-8 transition-colors hover:bg-coal/60 sm:px-8 sm:py-10',
            items.length % 3 === 0 && 'lg:flex-row lg:items-end',
          ]}
        >
          <span class="font-mono text-sm text-ash">{String(items.length + 1).padStart(2, '0')} · próximo</span>
          <span class="type-heading max-w-sm text-paper">{cta.title}</span>
          <span class="link-arrow">
            {cta.label}
            <Arrow />
          </span>
        </a>
      </li>
    )
  }
</ul>
