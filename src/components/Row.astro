---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  as?: 'section' | 'div' | 'header' | 'footer' | 'article';
  /** Draw "+" marks where the row's top edge meets the frame guides. */
  crosses?: boolean;
}

const { as: Tag = 'section', crosses = true, class: className, ...rest } = Astro.props;
---

<Tag class:list={['row', className]} {...rest}>
  {
    crosses && (
      <>
        <span class="cross cross-tl" aria-hidden="true" />
        <span class="cross cross-tr" aria-hidden="true" />
      </>
    )
  }
  <slot />
</Tag>
