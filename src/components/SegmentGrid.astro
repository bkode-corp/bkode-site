---
import Arrow from '@/components/Arrow.astro';
import { segments } from '@/data/segments';
---

<ul class="cells md:grid-cols-2">
  {
    segments.map((segment, i) => (
      <li>
        <a
          href={`/${segment.slug}`}
          class="group @container flex h-full flex-col gap-8 px-6 py-10 transition-colors hover:bg-coal/60 sm:px-10 sm:py-12"
        >
          <div class="flex items-start justify-between gap-6">
            <span class="font-mono text-sm text-ash">{String(i + 1).padStart(2, '0')}</span>
            <span class="label">/{segment.slug}</span>
          </div>
          <div>
            <h3 class="text-[clamp(1.5rem,8.5cqi,3rem)] leading-[1.05] font-semibold tracking-[-0.04em] text-paper">{segment.label}</h3>
            <p class="mt-4 max-w-md text-ash">{segment.audience}</p>
          </div>
          <ul class="mt-auto space-y-2 border-t border-line pt-6">
            {segment.offers.map((offer) => (
              <li class="flex gap-3 text-bone">
                <span aria-hidden="true" class="font-mono text-mute">→</span>
                {offer.title}
              </li>
            ))}
          </ul>
          <span class="link-arrow">
            Ver soluções para {segment.label.toLowerCase()}
            <Arrow />
          </span>
        </a>
      </li>
    ))
  }
</ul>
