# Canonical origin once the custom domain exists (e.g. https://bkode.tech). Vercel's production URL is used otherwise.
SITE_URL=

# Public contact channels. WhatsApp in international format, digits only (e.g. 5591900000000).
PUBLIC_WHATSAPP_NUMBER=
# Overrides the default inbox in src/data/site.ts.
PUBLIC_CONTACT_EMAIL=

# Contact form storage. The form is only shipped when both are set (see supabase/migrations).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional Cloudflare Turnstile anti-spam.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
